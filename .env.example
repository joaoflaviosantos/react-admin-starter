# Mock layer is the default for local demo.
# Do not point this starter at a backend on port 8000 for the happy path.
VITE_USE_MOCK=true
# Optional. Used only when VITE_USE_MOCK=false. Leave empty locally.
VITE_APP_BASE_API=
# Post-login redirect (history router).
VITE_APP_HOMEPAGE=/workbench/overview

# Set in Vercel Project Settings → Environment Variables for production demo:
# VITE_USE_MOCK=true
# VITE_APP_HOMEPAGE=/workbench/overview
# Leave VITE_APP_BASE_API empty (do not use localhost:8000)
